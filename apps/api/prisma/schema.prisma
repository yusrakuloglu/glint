generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // NodeNext requires explicit extensions on relative imports
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Conventions:
// - IDs are UUIDv7 (time-ordered, good index locality).
// - Timestamps use millisecond precision to match JS Date, so pagination
//   cursors round-trip without losing precision.
// - userId is the Supabase auth user id. Auth lives in a separate database,
//   so there is no foreign key to it.
// - Every user-owned child references its parent with (id, userId), so the
//   database rejects links between rows of different users.

enum ContentStatus {
  /// No page content yet: the server does not scrape (decision 003)
  AWAITING_CONTENT
  /// Queued for processing
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Next pipeline step to run; DONE once embeddings are written
enum ProcessingStep {
  EXTRACT
  SUMMARIZE
  CHUNK
  EMBED
  DONE
}

enum AiProvider {
  GEMINI
  GROQ
}

enum TagSource {
  USER
  AI
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  PURPLE
}

/// Shared per normalized URL: summaries and chunks are produced once for all users.
model Content {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// Normalized URL, max 2048 chars (CHECK constraint in migration)
  url             String         @unique
  title           String?
  siteName        String?        @map("site_name")
  byline          String?
  excerpt         String?
  summary         String?
  /// ISO 639-1 code of the content
  language        String?
  /// Plain text extracted from the page
  text            String?
  /// Readability output; not sanitized here, sanitized when rendered (Phase 4)
  articleHtml     String?        @map("article_html")
  wordCount       Int?           @map("word_count")
  /// sha256 of `text`; steps write only if it still matches what they read
  contentHash     String?        @map("content_hash")
  /// AI tag suggestions, applied to each user's saved link
  suggestedTags   String[]       @default([]) @map("suggested_tags")
  /// Which provider wrote the summary, for observability
  aiProvider      AiProvider?    @map("ai_provider")
  status          ContentStatus  @default(AWAITING_CONTENT)
  processingStep  ProcessingStep @default(EXTRACT) @map("processing_step")
  failureReason   String?        @map("failure_reason")
  /// Last change of status or processing step; the reconciler finds stuck content by it
  statusChangedAt DateTime       @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  savedLinks SavedLink[]
  chunks     Chunk[]
  snapshots  PageSnapshot[]

  @@index([status, statusChangedAt])
  @@map("contents")
}

/// Raw page HTML sent by a client, kept only until the extract step has run.
/// Not put in the job payload: pg-boss keeps payloads in its archive.
model PageSnapshot {
  id        String   @id @default(uuid(7)) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  /// Who sent it; their AI quota paid for the processing
  userId    String   @map("user_id") @db.Uuid
  /// gzip of the page HTML with script and style elements removed
  htmlGzip  Bytes    @map("html_gzip")
  /// Page language as reported by the client (document lang attribute)
  lang      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@map("page_snapshots")
}

/// AI-backed processing runs per user and UTC day, for the daily quota
model AiUsage {
  userId String   @map("user_id") @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
  @@map("ai_usage")
}

/// A user's save of a Content. Soft deleted; saving the same URL again restores it.
model SavedLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  contentId   String    @map("content_id") @db.Uuid
  /// URL as the user submitted it, before normalization
  originalUrl String    @map("original_url")
  /// User override of Content.title
  title       String?
  note        String?
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  content         Content          @relation(fields: [contentId], references: [id], onDelete: Restrict)
  tags            SavedLinkTag[]
  collectionItems CollectionItem[]
  highlights      Highlight[]

  @@unique([userId, contentId])
  // Target of composite foreign keys from user-owned children
  @@unique([id, userId])
  // Cursor pagination: newest first, id breaks ties
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("saved_links")
}

model Chunk {
  id         String                      @id @default(uuid(7)) @db.Uuid
  contentId  String                      @map("content_id") @db.Uuid
  index      Int
  text       String
  tokenCount Int                         @map("token_count")
  /// multilingual-e5-small; read and written with raw SQL
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, index])
  @@map("chunks")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// Trimmed, NFC-normalized, lowercased name; unique per user
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  links SavedLinkTag[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@map("tags")
}

model SavedLinkTag {
  userId      String    @map("user_id") @db.Uuid
  savedLinkId String    @map("saved_link_id") @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid
  source      TagSource @default(USER)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  savedLink SavedLink @relation(fields: [savedLinkId, userId], references: [id, userId], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([savedLinkId, tagId])
  @@index([tagId])
  @@map("saved_link_tags")
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items CollectionItem[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@map("collections")
}

model CollectionItem {
  userId       String   @map("user_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  savedLinkId  String   @map("saved_link_id") @db.Uuid
  /// Fractional index key for drag-and-drop ordering (Phase 4)
  position     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  collection Collection @relation(fields: [collectionId, userId], references: [id, userId], onDelete: Cascade)
  savedLink  SavedLink  @relation(fields: [savedLinkId, userId], references: [id, userId], onDelete: Cascade)

  @@id([collectionId, savedLinkId])
  @@index([savedLinkId])
  @@map("collection_items")
}

model Highlight {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  savedLinkId String         @map("saved_link_id") @db.Uuid
  /// Highlighted text, kept for display even if re-anchoring fails
  quote       String
  /// W3C TextQuote + TextPosition selectors; shape validated with Zod
  selector    Json
  color       HighlightColor @default(YELLOW)
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  savedLink SavedLink @relation(fields: [savedLinkId, userId], references: [id, userId], onDelete: Cascade)

  @@index([savedLinkId])
  @@map("highlights")
}
