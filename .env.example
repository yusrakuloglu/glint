# Database
DATABASE_URL=postgresql://glint:glint@localhost:5432/glint

# API
API_PORT=3001
# Browser origin of the web app, allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Supabase project URL (Settings → API), without a path.
# The API verifies access tokens with this project's JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co

# AI processing runs per user and UTC day; pages over the limit wait for a later day
AI_DAILY_LIMIT_PER_USER=50
# Days (1-30) such pages may wait; each waiting page keeps its snapshot stored
AI_MAX_DEFER_DAYS=7

# Web
# API base URL used by the browser (inlined into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001
